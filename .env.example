# ===== AI 对诗平台配置模板 =====
# 复制本文件为 .env 后填写

# ---- 云端模型（任意 OpenAI 兼容厂商）----
# 留空则自动跳过云端，走本地/Mock
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=deepseek-chat

# ---- 本地模型（Ollama，OpenAI 兼容端点）----
# 需自行安装 Ollama 并拉取模型，例如: ollama pull qwen2.5:7b
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b

# ---- 请求参数 ----
REQUEST_TIMEOUT=60          # AI 生成超时（秒）
HEALTH_TIMEOUT=3            # 可用性探测超时（秒）
